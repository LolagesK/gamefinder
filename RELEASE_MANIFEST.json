{
  "release": "0.4.0",
  "cloudflareBase": "0.3.4",
  "localBase": "0.3.0",
  "deployed": false,
  "import": "GitHub Actions -> D1 REST API",
  "source": "Austrum-lab/steam-appdb data/game.json",
  "schedule": "daily 03:20 UTC",
  "maxSourceEntriesPerRun": 30000,
  "preservesExistingData": true,
  "secretsRequired": [
