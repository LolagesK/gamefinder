{
  "name": "gamefinder-pc-catalog",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamefinder-catalog",
      "database_id": "13e2158d-521d-4db3-bf98-7e50aa5e9ca2"
    }
  ]
}
